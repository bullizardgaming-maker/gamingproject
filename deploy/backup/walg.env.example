# WAL-G settings for the postgres container (docker compose --profile backup, or your orchestrator).
# Use a bucket in a different account/region from production, with versioning and object lock on,
# so a compromised production host cannot delete its own backups.
WALG_S3_PREFIX=s3://bullizard-db-backups/prod
AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: write-only credentials (PutObject, no DeleteObject)
WALG_COMPRESSION_METHOD=zstd
# Client-side encryption of backups (libsodium key, 32 bytes hex). Store it in your secrets manager,
# separately from DATA_ENCRYPTION_KEYS.
# WALG_LIBSODIUM_KEY=
# WALG_LIBSODIUM_KEY_TRANSFORM=hex
PGHOST=/var/run/postgresql
PGUSER=market
PGDATABASE=market
