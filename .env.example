# Copy to .env. Every secret below MUST be replaced outside local development.
NODE_ENV=development
PORT=4000
PUBLIC_WEB_URL=http://localhost:5173
# Public URL of this API (used in docs and hosted-checkout links). Defaults to http://localhost:$PORT.
# PUBLIC_API_URL=https://api.yourdomain.com

# Network edge. Trust X-Forwarded-For only from your own proxies: a hop count ("1" behind one
# load balancer) or their addresses/CIDRs. Leaving it "false" behind a proxy makes every client
# look like the proxy; setting "true" lets clients forge their IP (rate-limit and fraud bypass).
TRUST_PROXY=false                          # also accepts proxy-addr names: loopback, uniquelocal
# GEO_COUNTRY_HEADER=cf-ipcountry           # country header set by your CDN/edge; ignored when unset
RATE_LIMIT_PER_MINUTE=300                  # per client IP
AUTH_RATE_LIMIT_PER_MINUTE=10              # sign-in, sign-up, 2FA, password reset
LOGIN_MAX_FAILURES=10                      # wrong passwords/2FA codes before sign-in is paused for the account
LOGIN_LOCK_MINUTES=15                      # doubles on each repeat lock, capped at 24h; a password reset lifts it
# DB_POOL_MAX=20                           # Postgres connections per process
# DATABASE_READ_URL=postgres://...replica   # search/listings/profiles/metrics; falls back to the primary if lagging
# REPLICA_MAX_LAG_SECONDS=10

# Bot checks (sign-up, password reset, and sign-in after failures from one IP)
CAPTCHA_PROVIDER=none                      # none | turnstile | hcaptcha
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET=
# CAPTCHA_AFTER_FAILED_LOGINS=3
# REDIS_URL also makes rate limits shared across API nodes.

# Observability
LOG_LEVEL=info
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.05
# METRICS_TOKEN=long-random-string        # required to scrape /metrics; /metrics is off in production without it

# Sandbox deployments only (requires PAYMENT_PROVIDER=mock and KYC_PROVIDER=mock)
# SANDBOX_MODE=true
DATABASE_URL=postgres://market:market@localhost:5432/market
# REDIS_URL=redis://localhost:6379        # required when running more than one API node

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# AES-256-GCM keyring, "version:base64(32 bytes)". Append a new key to rotate; the last one encrypts.
# The worker then re-encrypts old data; remove the old key once GET /v1/admin/keys lists it as safe to remove.
# Generate: node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEYS=v1:REPLACE_ME_BASE64_32_BYTES
FINGERPRINT_KEY=change-me

# Payments: mock | stripe
PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Identity verification: mock | sumsub
KYC_PROVIDER=mock
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET_KEY=
# SUMSUB_WEBHOOK_SECRET=
# SUMSUB_LEVEL_NAME=basic-kyc-level

# Email: console (logs) | postmark
EMAIL_PROVIDER=console
# EMAIL_FROM=Bullizard <no-reply@yourdomain.com>
# POSTMARK_SERVER_TOKEN=

# SMS: console (logs) | twilio. Twilio Lookup also blocks VoIP/virtual numbers.
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15551234567          # or a Messaging Service SID (MG...)

# Currencies: everything internal is in SETTLEMENT_CURRENCY; buyers can pay and sellers can list in SUPPORTED_CURRENCIES.
SETTLEMENT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,GBP
FX_PROVIDER=ecb                 # ecb = European Central Bank daily rates; static = FX_STATIC_RATES (dev)
FX_SPREAD_BPS=100               # 1% added when the buyer pays in a different currency
FX_MAX_AGE_HOURS=48             # refuse non-settlement payments if rates are older than this

# Referrals (paid as store credit after the friend's first completed order)
REFERRAL_REWARD_CENTS=500
REFERRAL_MIN_ORDER_CENTS=1000
REFERRAL_MONTHLY_CAP=20

# Payout holds: days released money waits before withdrawal, by seller track record
PAYOUT_HOLD_DAYS_NEW=7
PAYOUT_HOLD_DAYS_ESTABLISHED=3
PAYOUT_HOLD_DAYS_TRUSTED=0
PAYOUT_HOLD_DAYS_WATCH=14

# Tax on commission (VAT/GST) and commission invoices
PLATFORM_LEGAL_NAME=Bullizard Ltd
PLATFORM_TAX_COUNTRY=IE
# PLATFORM_VAT_ID=IE1234567T
# PLATFORM_ADDRESS=1 Example Street, Dublin
# TAX_REGISTERED_COUNTRIES=GB,NO        # non-EU countries where you're registered for digital-services VAT/GST
VAT_VALIDATION=none                     # none | vies (checks sellers' EU VAT numbers)
INVOICE_SERIES=BZ

# Data retention (days)
RETENTION_ENABLED=true
# RETENTION_CHAT_DAYS=730               # after the order closes (never while a dispute/chargeback is open)
# RETENTION_INQUIRY_CHAT_DAYS=180
# RETENTION_DELIVERED_ITEMS_DAYS=365
# RETENTION_FRAUD_SIGNALS_DAYS=730
# RETENTION_ORDER_IP_DAYS=540
# RETENTION_SESSIONS_DAYS=90
# RETENTION_NOTIFICATIONS_DAYS=90
# RETENTION_WEBHOOK_DELIVERIES_DAYS=90
# RETENTION_SECURITY_LOGS_DAYS=90

# Late manual deliveries are refunded automatically this long after the promised time
LATE_AUTO_REFUND_HOURS=48

# Chat evidence uploads
STORAGE_PROVIDER=local          # local (encrypted files in STORAGE_DIR) | s3 (private bucket, SSE)
STORAGE_DIR=./data/uploads
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=                  # for R2/MinIO
MALWARE_SCANNER=dev             # dev (detects the EICAR test file only) | clamd (required in production)
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310

# Daily money reconciliation
RECON_INTERVAL_HOURS=24
RECON_TOLERANCE_CENTS=0

# Staff (admin/arbiter) actions require a two-factor session. Defaults to true in production.
# STAFF_MFA_REQUIRED=true

# Fraud
# FRAUD_GNN_URL=http://localhost:8090
FRAUD_REVIEW_THRESHOLD=0.5
FRAUD_FREEZE_THRESHOLD=0.8
OFFPLATFORM_SUSPEND_STRIKES=3

# Web3 escrow
# ESCROW_RPC_URL=https://...
# ESCROW_CHAIN_ID=8453
# ESCROW_CONTRACT_ADDRESS=0x...
ESCROW_SIGNER=local                        # local (ESCROW_SIGNER_PRIVATE_KEY, dev only) | aws_kms
# ESCROW_KMS_KEY_ID=alias/bullizard-escrow  # KMS key spec ECC_SECG_P256K1, usage SIGN_VERIFY
# ESCROW_SIGNER_PRIVATE_KEY=0x...          # refused in production unless ESCROW_ALLOW_LOCAL_KEY_IN_PRODUCTION=true
# ESCROW_TOKEN_USDC=0x...
# ESCROW_TOKEN_USDT=0x...
CRYPTO_INDEXER_SECRET=change-me
