# Copy to .env. Every secret below MUST be replaced outside local development.
NODE_ENV=development
# APP_ENV=staging                          # staging: NODE_ENV=production + every production check, MALWARE_SCANNER=dev allowed
PORT=4000
PUBLIC_WEB_URL=http://localhost:5173
# Public URL of this API (used in docs and hosted-checkout links). Defaults to http://localhost:$PORT.
# PUBLIC_API_URL=https://api.yourdomain.com

# Network edge. Trust X-Forwarded-For only from your own proxies: a hop count ("1" behind one
# load balancer) or their addresses/CIDRs. Leaving it "false" behind a proxy makes every client
# look like the proxy; setting "true" lets clients forge their IP (rate-limit and fraud bypass).
TRUST_PROXY=false                          # also accepts proxy-addr names: loopback, uniquelocal
# GEO_COUNTRY_HEADER=cf-ipcountry           # country header set by your CDN/edge; ignored when unset
# Behind Cloudflare: the X-Origin-Auth value a Cloudflare Transform Rule adds. When set, other requests are refused
# (403, except /readyz and /healthz) and the client IP is CF-Connecting-IP. openssl rand -hex 32
# Required in production (APP_ENV=production); staging may leave it blank (a warning is logged at start).
# ORIGIN_SHARED_SECRET=
# Staging only (APP_ENV=staging; refused anywhere else): sign-ins carrying X-Staging-Test-Token = this value skip
# Turnstile, for the staging test workflows (.github/workflows/staging-*.yml). openssl rand -hex 32 (≥ 32 characters)
# STAGING_TEST_TOKEN=
# Blank optional values (e.g. a Render `sync: false` key left empty) count as unset: the default applies.
# WS_PING_SECONDS=30                       # WebSocket keep-alive (Cloudflare drops idle sockets after 100 s)
RATE_LIMIT_PER_MINUTE=300                  # per client IP
AUTH_RATE_LIMIT_PER_MINUTE=10              # sign-in, sign-up, 2FA, password reset
LOGIN_MAX_FAILURES=10                      # wrong passwords/2FA codes before sign-in is paused for the account
LOGIN_LOCK_MINUTES=15                      # doubles on each repeat lock, capped at 24h; a password reset lifts it
# DB_POOL_MAX=20                           # Postgres connections per process
# DATABASE_READ_URL=postgres://...replica   # search/listings/profiles/metrics; falls back to the primary if lagging
# REPLICA_MAX_LAG_SECONDS=10

# Web Push (in-app notification centre works without it). Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@yourdomain.com

# AML: sanctions screening and transaction monitoring
SANCTIONS_SOURCE=none                      # ofac in production (downloads the OFAC SDN list daily)
# SANCTIONS_EXTRA_LISTS=eu=https://.../eu.csv,uk=https://.../uk.csv   # CSV columns: ref,kind,name,program
# SANCTIONS_HOLD_SCORE=0.9                 # name similarity that pauses payouts
# SANCTIONS_REVIEW_SCORE=0.75              # opens a case for review only
# AML_THRESHOLD_CENTS=100000               # structuring band is 80-100% of this
# Production refuses payouts while no sanctions list is loaded.

# Bot checks (sign-up, password reset, and sign-in after failures from one IP). Production and staging need
# Cloudflare Turnstile: TURNSTILE_SECRET (+ TURNSTILE_SITE_KEY, and VITE_TURNSTILE_SITE_KEY for the web build);
# with it every sign-in asks for a token. Cloudflare test keys: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA (always passes) / 2x0000000000000000000000000000000AA (always fails).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# TURNSTILE_HOSTNAME=                      # host tokens must come from; defaults to PUBLIC_WEB_URL's host
CAPTCHA_PROVIDER=none                      # none | turnstile | hcaptcha
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET=
# CAPTCHA_AFTER_FAILED_LOGINS=3
# REDIS_URL also makes rate limits shared across API nodes.

# Observability
LOG_LEVEL=info
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.05
# METRICS_TOKEN=long-random-string        # required to scrape /metrics; /metrics is off in production without it
#                                          # behind Cloudflare the scraper goes through Cloudflare (X-Origin-Auth) + this token

# Sandbox deployments only (requires PAYMENT_PROVIDER=mock and KYC_PROVIDER=mock)
# SANDBOX_MODE=true
# Hosted Postgres (Neon): end the URL with ?sslmode=verify-full (require is upgraded to verify-full by the API).
DATABASE_URL=postgres://market:market@localhost:5432/market
# REDIS_URL=redis://localhost:6379        # required when running more than one API node

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# AES-256-GCM keyring, "version:base64(32 bytes)". Append a new key to rotate; the last one encrypts.
# The worker then re-encrypts old data; remove the old key once GET /v1/admin/keys lists it as safe to remove.
# Generate: node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEYS=v1:REPLACE_ME_BASE64_32_BYTES
FINGERPRINT_KEY=change-me

# Payments: mock | stripe | nowpayments (crypto in and out; the launch provider)
# NOWPayments: API key + IPN secret from the dashboard (Store settings). Sandbox: NOWPAYMENTS_API_URL=https://api-sandbox.nowpayments.io
# and a sandbox account's key. Payouts need the account login and, for automatic verification, the account's 2FA secret.
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_API_URL=https://api.nowpayments.io
# NOWPAYMENTS_EMAIL=
# NOWPAYMENTS_PASSWORD=
# NOWPAYMENTS_2FA_SECRET=
# NOWPAYMENTS_OUTCOME_CURRENCY=usdttrc20
# NOWPAYMENTS_SANDBOX_CASE=success          # sandbox only: success | partially_paid | failed
# Seller withdrawals: 6% fee with a $1.50 floor, approved by finance before anything is sent.
# WITHDRAWAL_FEE_BPS=600
# WITHDRAWAL_FEE_MIN_CENTS=150
# The on-chain MarketEscrow rail (USDC/USDT with the contract) is off at launch.
# ONCHAIN_ESCROW_ENABLED=false
# Sellers must attach a photo/video proof before an in-game delivery (currency, items, top-ups, boosting) counts.
DELIVERY_PROOF_REQUIRED=true
# Underpayments within this share of the price count as paid (dust, rounding): 50 = 0.5%.
# CRYPTO_UNDERPAY_TOLERANCE_BPS=50

PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Identity verification: mock | sumsub
KYC_PROVIDER=mock
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET_KEY=
# SUMSUB_WEBHOOK_SECRET=
# SUMSUB_LEVEL_NAME=basic-kyc-level

# Email: console (logs) | postmark | resend. Production and staging refuse console; they use resend.
EMAIL_PROVIDER=console
# EMAIL_FROM=Bullizard <no-reply@mail.bullizard.com>
# EMAIL_REPLY_TO=support@bullizard.com
# RESEND_API_KEY=                          # Resend (no open/click tracking: keep it off on the domain)
# POSTMARK_SERVER_TOKEN=
# ALERTS_EMAIL=alerts@bullizard.com        # ops alerts and reconciliation also go here
# FINANCE_EMAIL=finance@bullizard.com      # reconciliation results also go here
# Newsletter (opt-in): synced to Brevo when set, else Ops → Business → "Download subscribers (CSV)"
# BREVO_API_KEY=
# BREVO_LIST_ID_EN=                        # list "Newsletter EN"
# BREVO_LIST_ID_AR=                        # list "Newsletter AR"
# NEWSLETTER_SENDER=Bullizard <news@news.bullizard.com>   # sender for campaigns (set in Brevo)

# SMS: console (logs) | twilio. Twilio Lookup also blocks VoIP/virtual numbers. Production refuses console.
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15551234567          # or a Messaging Service SID (MG...)

# Currencies: everything internal is in SETTLEMENT_CURRENCY; buyers can pay and sellers can list in SUPPORTED_CURRENCIES.
SETTLEMENT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,EGP
FX_PROVIDER=live                # live = ECB rates + open.er-api.com (covers EGP); ecb = ECB only; static = FX_STATIC_RATES (dev)
FX_SPREAD_BPS=0                 # no spread while everything is charged in USD (CFO B12); EUR/EGP are shown as approximate
PAYOUT_CURRENCIES=USD           # payout currency lock (CFO B12): comma list sellers may choose from
FX_MAX_AGE_HOURS=48             # refuse non-settlement payments if rates are older than this

# Referrals (paid as store credit after the friend's first completed order)
# Referral share of Bullizard's commission and the activity window are staff-set (Ops → Ranks → Referral).

# Payout holds: days released money waits before withdrawal, by seller track record
# CEO, Oct 24: new sellers 1 day, established 0, watch list 14
PAYOUT_HOLD_DAYS_NEW=1
PAYOUT_HOLD_DAYS_ESTABLISHED=0
PAYOUT_HOLD_DAYS_TRUSTED=0
PAYOUT_HOLD_DAYS_WATCH=14

# Tax on commission (VAT/GST) and commission invoices. Until a company exists, leave PLATFORM_TAX_COUNTRY unset:
# no VAT is charged on any commission (CFO B3). Set it (e.g. IE, EG) once the company is registered.
PLATFORM_LEGAL_NAME=Bullizard
# PLATFORM_TAX_COUNTRY=IE
# PLATFORM_VAT_ID=IE1234567T
# PLATFORM_ADDRESS=1 Example Street, Dublin
# TAX_REGISTERED_COUNTRIES=GB,NO        # non-EU countries where you're registered for digital-services VAT/GST
VAT_VALIDATION=none                     # none | vies (checks sellers' EU VAT numbers)
INVOICE_SERIES=BZ

# Data retention (days)
RETENTION_ENABLED=true
# RETENTION_CHAT_DAYS=730               # after the order closes (never while a dispute/chargeback is open)
# RETENTION_INQUIRY_CHAT_DAYS=180
# RETENTION_DELIVERED_ITEMS_DAYS=365
# RETENTION_FRAUD_SIGNALS_DAYS=730
# RETENTION_ORDER_IP_DAYS=540
# RETENTION_SESSIONS_DAYS=90
# RETENTION_NOTIFICATIONS_DAYS=90
# RETENTION_SECURITY_LOGS_DAYS=90

# Weekly retention digest emailed to staff with analytics access every Monday (UTC); the subject
# starts with "Alert:" when last month's seller churn is above, or the 90-day repeat rate below, these lines.
COHORT_DIGEST_ENABLED=true
# COHORT_ALERT_SELLER_CHURN_PCT=20
# COHORT_ALERT_REPEAT_PCT=25

# Late manual deliveries: off at launch (buyers open a dispute; staff decide). When on, orders are refunded
# automatically this long after the promised time.
AUTO_REFUND_LATE_ORDERS=false
# Card payments are off at launch: refunds always land in the buyer's balance, never on a card
CARD_REFUNDS_ENABLED=false
CARD_PAYMENTS_ENABLED=false
LATE_AUTO_REFUND_HOURS=48

# Chat evidence uploads
STORAGE_PROVIDER=local          # local (encrypted files in STORAGE_DIR) | s3 (private bucket, SSE)
STORAGE_DIR=./data/uploads
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=                  # for R2/MinIO
MALWARE_SCANNER=dev             # dev (detects the EICAR test file only) | clamd (required in production)
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310

# Linked game accounts (sellers sign in to Steam/Riot to prove they control an account they list)
PLATFORM_ACCOUNTS=mock          # mock (completes instantly; dev, tests, sandbox) | live (required in production)
# STEAM_WEB_API_KEY=            # optional: adds the Steam profile name and account creation date
# RIOT_CLIENT_ID=               # Riot Sign On needs an approved Riot app; without it only Steam is offered
# RIOT_CLIENT_SECRET=
# RIOT_ACCOUNT_REGION=europe    # americas | asia | europe (Riot account API routing)

# Daily money reconciliation
RECON_INTERVAL_HOURS=24
RECON_TOLERANCE_CENTS=100            # CFO B7: $1 of dust is tolerated before a mismatch alert
PAYOUT_UNKNOWN_REVERSE_HOURS=6       # Round 22: a payout the provider says it never created is reversed only after this long and two checks

# Staff (admin/arbiter) actions require a two-factor session. Defaults to true in production.
# STAFF_MFA_REQUIRED=true           # cannot be false in production (Round 23d)
# Proof videos are re-muxed with ffmpeg so GPS/device metadata never reaches storage (Round 23d). 'off' is for tests only and refused in production.
# VIDEO_METADATA_STRIP=ffmpeg

# Fraud
# FRAUD_GNN_URL=http://localhost:8090
FRAUD_REVIEW_THRESHOLD=0.5
FRAUD_FREEZE_THRESHOLD=0.8
OFFPLATFORM_SUSPEND_STRIKES=3     # the off-platform offence that bans (1 = instant ban); earlier ones warn

# Web3 escrow
# ESCROW_RPC_URL=https://...
# ESCROW_CHAIN_ID=8453
# ESCROW_CONTRACT_ADDRESS=0x...
ESCROW_SIGNER=local                        # local (ESCROW_SIGNER_PRIVATE_KEY, dev only) | aws_kms
# ESCROW_KMS_KEY_ID=alias/bullizard-escrow  # KMS key spec ECC_SECG_P256K1, usage SIGN_VERIFY
# ESCROW_SIGNER_PRIVATE_KEY=0x...          # refused in production unless ESCROW_ALLOW_LOCAL_KEY_IN_PRODUCTION=true
# ESCROW_TOKEN_USDC=0x...
# ESCROW_TOKEN_USDT=0x...
CRYPTO_INDEXER_SECRET=change-me

# Fraud model: shadow (record only) until GET /v1/admin/fraud/model-report shows it beats the heuristic, then enforce.
FRAUD_GNN_MODE=shadow
FRAUD_LABEL_LEGIT_DAYS=120

# Seller debt collection: reminder days after a balance goes negative, then pause the shop.
DEBT_REMINDER_DAYS=0,3,7
DEBT_PAUSE_AFTER_DAYS=14
DEBT_CHECK_MINUTES=60

# Price alerts: how often watchlists are compared with the market.
WATCH_CHECK_MINUTES=15

# FX top-ups (buy EUR/GBP ahead of seller payouts). none = plan only and record conversions by hand.
FX_EXCHANGE_PROVIDER=none
# WISE_API_TOKEN=
# WISE_PROFILE_ID=
FX_TOPUP_BUFFER_BPS=500
FX_TOPUP_MIN_CENTS=10000
# Proposals costing up to this (settlement cents) execute without approval. 0 = always ask.
FX_TOPUP_AUTO_APPROVE_CENTS=0
